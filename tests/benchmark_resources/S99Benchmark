#!/bin/sh
# This bash script is for running the benchmarks, printing the results to console, then poweroff.

CMDLINE=$(cat /proc/cmdline)

case "$1" in
    start)
        for param in $CMDLINE; do
            case "$param" in
                benchmark=*)
                    MODE="${param#benchmark=}"
                    case "$MODE" in
                        shell)
                            echo "=== Dropping to shell (type 'exit' + 'poweroff' to quit) ===" > /dev/ttyS0
                            /bin/sh < /dev/ttyS0 > /dev/ttyS0 2>&1
                            poweroff
                            ;;
                        file_ops*)
                            echo "===RESULTS_START==="  > /dev/ttyS0
                            /root/benchmarks/file_ops.sh ${MODE#file_ops}
                            echo "===RESULTS_END==="    > /dev/ttyS0
                            poweroff
                            ;;
                        *)
                            echo "===RESULTS_START==="  > /dev/ttyS0
                            /root/benchmarks/fio.sh "$MODE"
                            echo "===RESULTS_END==="    > /dev/ttyS0
                            poweroff
                            ;;
                    esac
                    ;;
            esac
        done
        ;;
    stop)
        ;;
esac
